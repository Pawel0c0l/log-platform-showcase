[Unit]
Description=Complete Workflow B orchestrator
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=logplatform
Group=logplatform
WorkingDirectory=/opt/log-platform
UMask=0077
TimeoutStartSec=6h
ExecStart=/usr/local/bin/log-job-runner.sh jobs.reports.workflow_b.orchestrator {}
# The orchestrator raises operator incidents from inside this process
# (ops/runner.py -> ops.operational_alert), and `SUSPECTED_BUG_ALERT_TO` lives
# only in /etc/log-platform/runtime.env, which is root:root 0600 — the job user
# cannot read it, so systemd injecting it before dropping privileges is the only
# supply route. Without these lines the process resolves zero recipients and
# every rich Workflow B incident is persisted with
# email_decision_reason='recipients_not_configured': recorded, never sent, while
# the coarse unit-level alert is the only thing that reaches the operator.
# `log-job@dispatcher.service` and `log-job@retention-purge.service` already
# carry exactly this pair; this unit was the outlier.
EnvironmentFile=/etc/log-platform/runtime.env
EnvironmentFile=/etc/log-platform/environment-identity.env
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
