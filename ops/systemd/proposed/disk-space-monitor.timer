[Unit]
Description=Check platform filesystem headroom hourly
# No Requires=disk-space-monitor.service: a timer's [Unit] dependencies are
# activated when the TIMER starts, so Requires= makes `systemctl start` (and
# `enable --now`) run the job immediately. Unit= below is the only link a
# timer needs.

[Timer]
# Hourly is ample: measured growth is ~7 GB/night against tens of GB of headroom,
# and incident cooldown prevents repeated notification while a threshold holds.
OnBootSec=5min
OnUnitActiveSec=1h
Persistent=true
AccuracySec=5min
Unit=disk-space-monitor.service

[Install]
WantedBy=timers.target
