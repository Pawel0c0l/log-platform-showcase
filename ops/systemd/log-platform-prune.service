[Unit]
Description=Log Platform fail-closed retention prune
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=logplatform
Group=logplatform
WorkingDirectory=/opt/log-platform
EnvironmentFile=/etc/log-platform-host.env
EnvironmentFile=/etc/log-platform/environment-identity.env
UMask=0077
TimeoutStartSec=30min
ExecStart=/usr/local/bin/log-platform-prune.sh --execute --days 60
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/log-platform/backups

[Install]
WantedBy=multi-user.target
