# =========================
# Log Platform environment
# =========================
# Copy to .env and fill real values.
# Do not commit secrets.

# --- API + Docker ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=logdb
POSTGRES_USER=loguser
POSTGRES_PASSWORD=CHANGE_ME

# --- Fail-closed identity for guarded operational commands (non-secret) ---
# Canonical values: local_dev, staging, production (case-sensitive); production is never inferred.
# Environment promotion preserves the UUID of each existing database instance.
# Generate a new UUID only when provisioning a newly cloned database instance.
# LOG_PLATFORM_TARGET_ENVIRONMENT is intentionally absent here. Provision the
# non-secret identity-only /etc/log-platform/environment-identity.env with
# ops/provision_runtime_environment_identity.py, then promote it only through
# ops/promote_environment_identity.py.
LOG_PLATFORM_EXPECTED_PLATFORM_IDENTITY_ID=CHANGE_ME_LOCAL_PLATFORM_UUID
LOG_PLATFORM_EXPECTED_POSTGRES_HOST=127.0.0.1
LOG_PLATFORM_EXPECTED_POSTGRES_PORT=5432
LOG_PLATFORM_EXPECTED_POSTGRES_DB=logdb
LOG_PLATFORM_EXPECTED_POSTGRES_USER=loguser
# Compose API expects Docker DNS while host guards continue using loopback.
LOG_PLATFORM_COMPOSE_EXPECTED_POSTGRES_HOST=postgres

MINIO_ENDPOINT=127.0.0.1:9000
# Optional explicit host override; host prune otherwise preserves a host-compatible
# MINIO_ENDPOINT and maps only the exact Compose default to loopback.
MINIO_HOST_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=artifacts
MINIO_SECURE=0
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

API_READ_TOKEN=CHANGE_ME
API_WRITE_TOKEN=CHANGE_ME
ARTIFACT_EXPLORER_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
BUSINESS_TIMEZONE=Europe/Warsaw

# --- Runner / jobs (host) ---
LOG_API_URL=http://127.0.0.1:8000

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=automations.scheduled@example.invalid
IMAP_PASSWORD=CHANGE_ME
IMAP_MAILBOX=INBOX

REPORTS_DATA_DIR=/home/logplatform/data/reports
ARTIFACT_EXPLORER_BASE_URL=http://localhost:8000

CONTENT_DEDUP_MODE=tables_70_90
CONTENT_DEDUP_RANGE_START=0.70
CONTENT_DEDUP_RANGE_END=0.90
REPORT_LINK_DOMAINS_ALLOWLIST=telematics-provider.example,fleetmail.telematics-provider.example,mail.example.invalid
REPORT_LINK_MAX_BYTES=104857600
REPORT_LINK_TIMEOUT_SECS=60
REPORT_LINK_VERIFY_TLS=true
REPORT_LINK_PREFLIGHT=1
REPORT_LINK_RANGE_SAMPLE_BYTES=65536

# Stage 2 pending-review email notifications.
AUTOMATION_SMTP_HOST=smtp.example.com
AUTOMATION_SMTP_PORT=587
AUTOMATION_SMTP_USERNAME=automations@example.invalid
AUTOMATION_SMTP_PASSWORD=CHANGE_ME
AUTOMATION_SMTP_USE_TLS=true
AUTOMATION_SMTP_FROM=automations@example.invalid
STAGE2_PENDING_REVIEW_NOTIFY_TO=owner@example.invalid

# suspected_bug alert emails (platform-level defect/invariant alerts).
# Delivery uses the AUTOMATION_SMTP_* transport above. There is NO recipient
# fallback: with SUSPECTED_BUG_ALERT_TO unset, logs and incidents are still
# persisted and the outbox row is simply not created.
#
# THIS IS THE SINGLE MOST IMPORTANT SETTING FOR UNATTENDED OPERATION. Without it
# every operator alert is silently suppressed as `recipients_not_configured`, and
# an entirely inert alert path looks exactly like a healthy one. Check with:
#     .venv/bin/python -m ops.operational_alert     # exit 0 = alerts deliverable
# See docs/17_production_hardening_roadmap.md.
# SUSPECTED_BUG_ALERT_TO=
# SUSPECTED_BUG_ALERTS_ENABLED=true
# SUSPECTED_BUG_ALERT_FROM=
# SUSPECTED_BUG_ALERT_COOLDOWN_MINUTES=120
# SUSPECTED_BUG_ALERT_REMINDER_HOURS=24
# SUSPECTED_BUG_ALERT_SCOPE_GROWTH_FACTOR=2
# SUSPECTED_BUG_EMAIL_MAX_ATTEMPTS=6
# SUSPECTED_BUG_EMAIL_INITIAL_RETRY_SECONDS=60
# SUSPECTED_BUG_EMAIL_MAX_RETRY_SECONDS=3600
# SUSPECTED_BUG_EMAIL_WORKER_BATCH_SIZE=10
# SUSPECTED_BUG_EMAIL_STALE_CLAIM_SECONDS=900

# Eco Driving weekly driver email notifications.
ECO_WEEKLY_EMAIL_SMTP_HOST=smtp.example.com
ECO_WEEKLY_EMAIL_SMTP_PORT=587
ECO_WEEKLY_EMAIL_SMTP_USERNAME=no-reply.eco-alpha@example.invalid
ECO_WEEKLY_EMAIL_SMTP_PASSWORD=CHANGE_ME
ECO_WEEKLY_EMAIL_SMTP_USE_TLS=true
ECO_WEEKLY_EMAIL_SMTP_USE_SSL=false
ECO_WEEKLY_EMAIL_FROM_EMAIL=no-reply.eco-alpha@example.invalid
ECO_WEEKLY_EMAIL_FROM_NAME=Program Ecodriving
ECO_WEEKLY_EMAIL_REPLY_TO=
ECO_WEEKLY_EMAIL_TIMEOUT_SECONDS=30
# One authenticated SMTP session per RUN for all four Eco mailers (the relay
# delays every new connection's greeting by 12-25 s; a kept session pays it
# once). Each message still gets its own final reply and classification.
# Set _REUSE=false to fall back to one session per message without a release;
# _MAX_MESSAGES=N reconnects after N messages (unset/0 = until the relay ends it).
# ECO_EMAIL_SMTP_SESSION_REUSE=true
# ECO_EMAIL_SMTP_SESSION_MAX_MESSAGES=0
# Sent-folder copy for the ALPHA weekly AND monthly mailers (they share this
# sender account). With none of these set, no copy is filed and the run summary
# reports sent_archive_enabled=false; a PARTIAL configuration is an error.
# The copy is filed in the mailbox the message was SENT FROM, so it logs in with
# ECO_WEEKLY_EMAIL_SMTP_USERNAME / _SMTP_PASSWORD above — do NOT duplicate them.
# Only the IMAP endpoint has to be stated; it is a different service and is
# never derived from the SMTP host/port.
# ECO_WEEKLY_EMAIL_IMAP_HOST=
# ECO_WEEKLY_EMAIL_IMAP_PORT=993
# ECO_WEEKLY_EMAIL_IMAP_USE_SSL=true
# ECO_WEEKLY_EMAIL_IMAP_TIMEOUT_SECONDS=30
# Optional overrides, ONLY when the provider needs a different IMAP login for
# this same mailbox. Unset, the SMTP credentials above are used:
# ECO_WEEKLY_EMAIL_IMAP_USERNAME=
# ECO_WEEKLY_EMAIL_IMAP_PASSWORD=CHANGE_ME
# Optional when discovery by IMAP \Sent special-use is unavailable:
# ECO_WEEKLY_EMAIL_IMAP_SENT_MAILBOX=INBOX.Sent

# Eco Driving Person email notifications (isolated from ALPHA00001 Eco Driving)
ECO_PERSON_EMAIL_SMTP_HOST=smtp.example.com
ECO_PERSON_EMAIL_SMTP_PORT=587
ECO_PERSON_EMAIL_SMTP_USERNAME=no-reply.ecodriving@example.com
ECO_PERSON_EMAIL_SMTP_PASSWORD=CHANGE_ME
ECO_PERSON_EMAIL_SMTP_USE_TLS=true
ECO_PERSON_EMAIL_SMTP_USE_SSL=false
ECO_PERSON_EMAIL_FROM_EMAIL=no-reply.ecodriving@example.com
ECO_PERSON_EMAIL_FROM_NAME=Program Ecodriving
ECO_PERSON_EMAIL_REPLY_TO=
ECO_PERSON_EMAIL_TIMEOUT_SECONDS=30
# Sent-folder copy for person clients that use THIS sender identity.
# BRAVO00016 does not: both its weekly and monthly mailers resolve the
# BRAVO_ECO_WEEKLY_EMAIL_* mailbox below. Same rule as above: unset means no
# copy, partial means error. Credentials default to the _SMTP_ ones above.
# ECO_PERSON_EMAIL_IMAP_HOST=
# ECO_PERSON_EMAIL_IMAP_PORT=993
# ECO_PERSON_EMAIL_IMAP_USE_SSL=true
# ECO_PERSON_EMAIL_IMAP_TIMEOUT_SECONDS=30
# Optional overrides; unset, the SMTP credentials above are used:
# ECO_PERSON_EMAIL_IMAP_USERNAME=
# ECO_PERSON_EMAIL_IMAP_PASSWORD=CHANGE_ME

# BRAVO00016 Eco Driving Person email notifications — WEEKLY AND MONTHLY.
# One dedicated sender mailbox per client, not per period: the `WEEKLY` in
# these names is historical. Passwords are protected runtime secrets.
BRAVO_ECO_WEEKLY_EMAIL_SMTP_HOST=mail.example.invalid
BRAVO_ECO_WEEKLY_EMAIL_SMTP_PORT=587
BRAVO_ECO_WEEKLY_EMAIL_SMTP_USERNAME=automations@example.invalid
BRAVO_ECO_WEEKLY_EMAIL_SMTP_PASSWORD=CHANGE_ME
BRAVO_ECO_WEEKLY_EMAIL_SMTP_USE_TLS=true
BRAVO_ECO_WEEKLY_EMAIL_SMTP_USE_SSL=false
BRAVO_ECO_WEEKLY_EMAIL_FROM_EMAIL=automations@example.invalid
BRAVO_ECO_WEEKLY_EMAIL_FROM_NAME="Ecodriving Telematics"
BRAVO_ECO_WEEKLY_EMAIL_REPLY_TO=
BRAVO_ECO_WEEKLY_EMAIL_TIMEOUT_SECONDS=30
BRAVO_ECO_WEEKLY_EMAIL_IMAP_HOST=mail.example.invalid
BRAVO_ECO_WEEKLY_EMAIL_IMAP_PORT=993
BRAVO_ECO_WEEKLY_EMAIL_IMAP_USE_SSL=true
# These two are the SAME account as the _SMTP_ credentials above and may be
# omitted entirely; they are kept explicit here only because this mailbox is
# already deployed with them set:
BRAVO_ECO_WEEKLY_EMAIL_IMAP_USERNAME=automations@example.invalid
BRAVO_ECO_WEEKLY_EMAIL_IMAP_PASSWORD=CHANGE_ME
BRAVO_ECO_WEEKLY_EMAIL_IMAP_TIMEOUT_SECONDS=30
# Optional when discovery by IMAP \Sent special-use is unavailable:
# BRAVO_ECO_WEEKLY_EMAIL_IMAP_SENT_MAILBOX=INBOX.Sent

# --- Workflow A / Telematics optional safety tuning ---
# Canonical defaults are documented in docs/02_infrastructure.md.
# TELEMATICS_PROVIDER_MAX_REQUESTS_PER_RUN=500
# TELEMATICS_PROVIDER_MAX_REQUESTS_PER_ENDPOINT=300
# TELEMATICS_PROVIDER_MAX_REQUESTS_PER_SUBWINDOW=80
# TELEMATICS_PROVIDER_MAX_PAGES_PER_SUBWINDOW=50
# TELEMATICS_PROVIDER_MAX_RETRIES=2
# TELEMATICS_PROVIDER_TIMEOUT_S=60
# TELEMATICS_PROVIDER_PAGE_LIMIT=200
# TELEMATICS_PROVIDER_VEHICLE_EVENTS_LIMIT=1000
# TELEMATICS_PROVIDER_VEHICLE_EVENTS_MAX_PAGES_PER_DAY=500
# TELEMATICS_EVENTS_CHUNK_HOURS=4
# TELEMATICS_EVENTS_MIN_CHUNK_MINUTES=30
# TELEMATICS_EVENTS_RATE_LIMIT_RPS=2.5
# TELEMATICS_EVENTS_ENRICHMENT_MODE=strict
# LOG_PLATFORM_ARTIFACT_TMP_DIR=/tmp
# WORKFLOW_A_DISPATCHER_STALE_RUNNING_TIMEOUT_MINUTES=720

# --- Maintenance ---
# Backup retention is enforced by ops/backup_retention.py (backup-retention.timer),
# not by ops/backup.sh. KEEP_MINIMUM is a hard safety floor: that many newest
# known-good sets survive regardless of age, so the last safe backup can never be
# deleted. Retention is dry-run unless --execute is passed.
# BACKUP_RETENTION_DAYS=14
# BACKUP_RETENTION_KEEP_MINIMUM=3

# Disk-space guard (ops/disk_space_monitor.py, disk-space-monitor.timer).
# Each threshold is a free-percentage floor AND a free-bytes floor; whichever is
# breached first wins, and critical wins over warning.
# DISK_MONITOR_WARNING_PERCENT=20
# DISK_MONITOR_CRITICAL_PERCENT=10
# DISK_MONITOR_WARNING_FREE_GB=60
# DISK_MONITOR_CRITICAL_FREE_GB=25
