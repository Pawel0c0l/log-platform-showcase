# -----------------------------------------------------------------------------
# Workflow B (backup / legacy IMAP ingest) — przykładowe zmienne środowiskowe
# Nazwa pliku jest historyczna („stage1” = Stage 1 łańcucha B).
# Workflow A (główny kierunek strategiczny) nie używa tego szablonu jako
# kanonicznej listy. Aktualne joby Telematics używają control-plane
# `workflow_a_control.client_account` oraz sekretów przez env-var albo `file:`.
# Copy to a local non-committed file (for example: .env.local) and fill real values.
# -----------------------------------------------------------------------------

# API access used by runner/client
LOG_API_URL=http://127.0.0.1:8000
API_READ_TOKEN=***NOT_COMMITTED***
API_WRITE_TOKEN=***NOT_COMMITTED***

# IMAP source (Workflow B)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=automations.scheduled@example.invalid
IMAP_PASSWORD=***NOT_COMMITTED***
IMAP_MAILBOX=INBOX

# Output paths
REPORTS_DATA_DIR=/home/logplatform/data/reports

# PostgreSQL used directly by jobs.mail.fetch_reports (Workflow B / ingest)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=logdb
POSTGRES_USER=loguser
POSTGRES_PASSWORD=***NOT_COMMITTED***

# Content deduplication
CONTENT_DEDUP_MODE=tables_70_90
CONTENT_DEDUP_RANGE_START=0.70
CONTENT_DEDUP_RANGE_END=0.90

# Link downloads for "(limit e-mail)" messages
REPORT_LINK_DOMAINS_ALLOWLIST=telematics-provider.example,fleetmail.telematics-provider.example,mail.example.invalid
REPORT_LINK_MAX_BYTES=104857600
REPORT_LINK_TIMEOUT_SECS=60
REPORT_LINK_VERIFY_TLS=true
REPORT_LINK_PREFLIGHT=1
REPORT_LINK_RANGE_SAMPLE_BYTES=65536
